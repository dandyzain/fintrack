{
  "name": "finance-tracker-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @fintrack/database db:generate",
    "db:push": "pnpm --filter @fintrack/database db:push",
    "db:studio": "pnpm --filter @fintrack/database db:studio"
  },
  "devDependencies": {
    "next": "^14.2.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
