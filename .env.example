# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL - Supabase / Neon)
# -----------------------------------------------------------------------------
# Connection pooling URL for queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations & push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# SUPABASE STORAGE & CLIENT
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_RECEIPT_BUCKET="receipts"

# -----------------------------------------------------------------------------
# VISION AI EXTRACTION (Google Gemini & OpenAI)
# -----------------------------------------------------------------------------
# Primary: Google Gemini Flash
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"

# Optional Fallback: OpenAI Vision
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"

# Local testing without incurring API costs
ENABLE_MOCK_AI="false"
