# -----------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# -----------------------------------------------------------------------------
# Signs session tokens. At least 32 random characters. Generate one with:
#   openssl rand -base64 48
# Without it the app refuses to sign anyone in when NODE_ENV=production.
SESSION_SECRET=""

# Public URL of the web app (used in password-reset and verification emails).
APP_URL="https://your-app.vercel.app"

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL - Supabase / Neon)
# Leave DATABASE_URL empty to run in memory mode (local trials only: data is
# lost on restart and the app shows a notice).
# -----------------------------------------------------------------------------
# Connection pooling URL for queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for migrations (pnpm db:deploy)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# RECEIPT STORAGE (Supabase Storage, PRIVATE bucket)
# The service-role key is server-only; never expose it with a NEXT_PUBLIC_ prefix.
# Without it, receipts are kept in server memory (development only).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RECEIPT_BUCKET="receipts"

# -----------------------------------------------------------------------------
# VISION AI EXTRACTION
# -----------------------------------------------------------------------------
GEMINI_API_KEY=""
# Alias that always points at Google's current Flash model.
GEMINI_MODEL="gemini-flash-latest"
# Optional fallback
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"
# Sample extraction instead of a real AI call, used only when no AI key is set.
# Opt-in, so it can also power a hosted demo.
ENABLE_MOCK_AI="false"

# -----------------------------------------------------------------------------
# EMAIL (password reset & verification) via Resend — optional
# Without it, development prints the links to the server log.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="FinTrack <no-reply@your-domain.com>"

# -----------------------------------------------------------------------------
# OPERATIONS — optional
# -----------------------------------------------------------------------------
# Protects /api/cron/recurring (Vercel sends it as a Bearer token automatically).
CRON_SECRET=""
# Server error reporting to Sentry (no SDK needed).
SENTRY_DSN=""
