# -----------------------------------------------------------------------------
# AUTH SESSION (REQUIRED in production)
# -----------------------------------------------------------------------------
# HMAC key that signs the `fintrack_session` login token. With
# NODE_ENV=production the server refuses to start (and every auth call fails)
# if this is empty. Generate one with:
#   openssl rand -base64 48
# Changing it invalidates all existing sessions (everyone is logged out).
# JWT_SECRET is still accepted as a legacy alias if SESSION_SECRET is unset.
SESSION_SECRET=""

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL - Supabase / Neon)
# -----------------------------------------------------------------------------
# When DATABASE_URL is set, every /api route except /api/auth/* requires a valid
# session and returns 401 otherwise. Leave it unset to run the in-memory demo
# mode (sample data, reset on restart; unauthenticated calls use the demo user).
# Connection pooling URL for queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations & push
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# SUPABASE STORAGE & CLIENT
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_RECEIPT_BUCKET="receipts"

# -----------------------------------------------------------------------------
# VISION AI EXTRACTION (Google Gemini & OpenAI)
# -----------------------------------------------------------------------------
# Primary: Google Gemini Flash
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"

# Optional Fallback: OpenAI Vision
OPENAI_API_KEY=""
OPENAI_VISION_MODEL="gpt-4o-mini"

# Local testing without incurring API costs
ENABLE_MOCK_AI="false"
